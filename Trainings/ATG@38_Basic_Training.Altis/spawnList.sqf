Fnc_SpawnMines = {
    // Safely pull the main multi-dimensional data array
    _MinesArray = _this;
    private _spawnedMines = [];

    {
        systemChat format["X is: %1",_X];
        
    
        // Direct selection avoids the params engine parser bug
        private _classname  = _x select 0;
        private _posATL     = _x select 1;
        private _vectorData = _x select 2;        

        // Verify the extracted types before executing commands
        if (_classname isEqualType "" && {typeName _posATL isEqualTo "ARRAY"} && {count _posATL >= 3}) then {
            
            // _vectorData looks like: [[-0,0,180],[-0,0,0]]
            private _dirXYZ = _vectorData select 0; 
            private _direction = _dirXYZ select 2; // Pulls the 180 (Heading Z-rotation)

            _posATL set [2,0];
            // Spawn natively via engine
            private _mine = createMine [_classname, _posATL, [], 0];
            systemChat format ["Spawned %1 at %2",_classname,_posATL];
            _mine setDir _direction;
            _mine setPosATL _posATL;

            _spawnedMines pushBack _mine;
        };
    } forEach _minesArray;

    _spawnedMines
};

